{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mobileme",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-03-30",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "FUEL_FINDER_ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/data/*",
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "FUEL_DATA_BUCKET",
      "bucket_name": "mobileme-fuel-data"
    }
  ],
  "triggers": {
    "crons": [
      "0 7,8 * * *"
    ]
  }
}
